<% alias BunnyStats.Report, as: H %>
<% b = r.snapshot["billing"] %>
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>Bunny Stats · <%= H.escape(r.month) %></title>
<style>
*{box-sizing:border-box}html{scroll-behavior:auto}body{margin:0;background:#000;color:#fff;font:14px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}main{max-width:1440px;margin:auto;padding:30px 38px 70px}h1{font-size:25px;letter-spacing:-.6px;margin:0}h2{font-size:18px;margin:0 0 16px}h3{font-size:14px;margin:15px 0 8px}p{margin:8px 0}a{color:#92c9f4}header{display:flex;align-items:baseline;justify-content:space-between;gap:20px}nav{display:flex;flex-wrap:wrap;gap:24px;border-bottom:1px solid #363636;padding:15px 0;margin:14px 0 24px}nav a{text-decoration:none}.muted,small{color:#aaa}.mono{font-family:ui-monospace,SFMono-Regular,monospace;font-size:12px}.summary{display:flex;flex-wrap:wrap;gap:24px 50px;margin:24px 0}.summary span{display:block;color:#aaa;font-size:13px}.summary strong{font-size:26px;line-height:1.4;font-weight:550;letter-spacing:-.6px}.summary .total{font-size:40px}.money,td:not(:first-child){font-variant-numeric:tabular-nums}.notice{border-left:3px solid #e9a35f;background:#15100a;padding:12px 16px;color:#f6c896;margin:22px 0}.notice p{margin:4px 0}.ok{color:#9dceaf}.mismatch,.missing{color:#f6c896}.columns{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:42px}.components{display:grid;grid-template-columns:repeat(2,1fr);gap:18px 25px}.component{border-bottom:1px solid #292929;padding-bottom:12px}.component .amount{font-size:23px;display:block}.component .bar{height:4px;background:#202020;margin:9px 0 6px}.component .bar i{display:block;background:#92c9f4;height:4px}section{margin-top:34px;padding-top:24px;border-top:1px solid #393939}table{width:100%;border-collapse:collapse}th,td{text-align:right;border-bottom:1px solid #262626;padding:9px 10px;vertical-align:top;font-weight:400}th{color:#bbb;font-size:12px}th:first-child,td:first-child{text-align:left;padding-left:0}td:first-child{overflow-wrap:anywhere}th:last-child,td:last-child{padding-right:0}.scroll{overflow-x:auto}.scroll table{min-width:720px}.rank td:first-child{max-width:350px}.rank a{text-decoration:none;color:#fff}.rank a:hover{text-decoration:underline;color:#92c9f4}.rank tbody tr:hover{background:#101010}details.app{border-top:1px solid #2b2b2b}details.app:last-of-type{border-bottom:1px solid #2b2b2b}summary{cursor:pointer;padding:14px 0;font-size:15px}summary:hover{color:#92c9f4}summary .app-cost{float:right;font-weight:500}summary .state{margin-left:14px;font-size:12px;color:#aaa}.app-content{padding:0 0 26px}.app .summary{margin:8px 0 12px;gap:30px}.app .summary strong{font-size:22px}.app-layout{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}.chart{max-width:650px}.chart svg{display:block;width:100%;height:110px;preserveAspectRatio:none}.chart-axis{display:flex;justify-content:space-between;color:#aaa;font-size:12px}.note{font-size:12px;color:#b0b0b0;max-width:1000px}.check-table{font-size:13px}.check-table th,.check-table td{white-space:nowrap}.check-table td:first-child{white-space:normal}.checks-note{max-width:1000px}.label{color:#92c9f4;font-size:12px}.toolbar{display:flex;align-items:center;gap:20px;margin:12px 0}input[type=search]{background:#090909;color:white;border:1px solid #555;padding:8px 10px;font:inherit;width:320px;max-width:100%}button{font:inherit;color:#ddd;background:#141414;border:1px solid #444;padding:7px 12px;cursor:pointer}button:hover{border-color:#92c9f4}footer{margin-top:38px;padding-top:20px;border-top:1px solid #333;color:#aaa;font-size:12px}.source-links{display:flex;gap:20px;flex-wrap:wrap}details.method{margin-top:18px}.method summary{font-size:13px}.method li{margin:7px 0}code{font-size:12px;color:#cbd8e2}[hidden]{display:none!important}a:focus-visible,summary:focus-visible,button:focus-visible,input:focus-visible{outline:2px solid #92c9f4;outline-offset:4px}@media(max-width:900px){main{padding:24px 18px}.columns,.app-layout{grid-template-columns:1fr;gap:24px}.summary{gap:18px 28px}header{display:block}.rank th:nth-child(2),.rank td:nth-child(2){display:none}summary .state{display:none}.toolbar{flex-wrap:wrap}summary{overflow-wrap:anywhere}.app-cost{margin-left:12px}.components{gap:16px}.summary .total{font-size:34px}}@media print{.toolbar,button{display:none}body{background:#fff;color:#000}main{padding:0}a,.muted,small{color:#333}details{break-inside:avoid}td,th{border-color:#ccc}}
</style>
</head>
<body><main>
<header><h1>Bunny Stats <span class="muted">/ <%= H.escape(r.month) %></span></h1><span class="note">Stand <%= H.escape(r.snapshot["fetchedAt"]) %> · USD · Tage in UTC</span></header>
<nav><a href="#overview">Übersicht</a><a href="#apps">Apps & Tage</a><a href="#volumes">Volumes</a><a href="#reconciliation">Abgleich</a></nav>
<div id="overview" class="summary">
  <div><span>Account gesamt</span><strong class="total"><%= H.money(b["ThisMonthCharges"]) %></strong></div>
  <%= for product <- r.products do %><div><span><%= H.escape(product.name) %></span><strong><%= H.money(product.cost) %></strong></div><% end %>
</div>
<% mc_check = Enum.at(r.checks, 1) %>
<%= if mc_check.status != :ok do %>
<div class="notice"><strong>Magic Containers: Abrechnungswerte widersprechen sich.</strong><p>Einzelposten <%= H.money(r.component_sum, 4) %> · MC-Abrechnung <%= H.money(b["MonthlyChargesMagicContainers"], 4) %> · Differenz <%= H.money(mc_check.delta, 4) %>.</p><p class="note">Unveränderte API-Werte. Keine rechnerische Anpassung. <a href="#reconciliation">Abgleich ansehen</a></p></div>
<% end %>
<%= if r.errors != [] do %><div class="notice"><strong>Abruf unvollständig</strong><%= for error <- r.errors do %><p><%= H.escape(error) %></p><% end %></div><% end %>
<div class="columns">
<div><h2>Apps nach Monatskosten</h2><table class="rank"><thead><tr><th>App</th><th>Status</th><th>API-Kosten</th><th>Anteil¹</th></tr></thead><tbody>
<%= for app <- r.apps do %><tr><td><a href="#app-<%= H.escape(app["id"]) %>" data-app-link><%= H.escape(app["name"]) %></a></td><td><%= H.app_status(app["status"]) %></td><td><%= H.money(app["monthlyCost"], 4) %></td><td><%= H.share(app["monthlyCost"], r.app_sum) %></td></tr><% end %>
</tbody><tfoot><tr><td>Summe vorhandener Apps</td><td></td><td><%= H.money(r.app_sum, 4) %></td><td><%= H.share(r.app_sum, r.app_sum) %></td></tr></tfoot></table><p class="note">¹ Anteil an der Summe der vorhandenen Apps, nicht am Account-Gesamtbetrag. Gelöschte Apps können fehlen.</p></div>
<div><h2>Magic Containers: Einzelposten</h2><div class="components">
<%= for c <- r.components, c.cost != nil do %><div class="component"><span><%= H.escape(c.name) %></span><strong class="amount"><%= H.money(c.cost, 4) %></strong><span class="note"><%= H.unit(c) %></span><div class="bar"><i style="width:<%= if r.component_sum && r.component_sum > 0, do: max(0, min(100, c.cost / r.component_sum * 100)), else: 0 %>%"></i></div><span class="note"><%= H.share(c.cost, r.component_sum) %> der Einzelposten</span></div><% end %>
</div><p class="note">Direkt aus <code>/billing</code>. Fehlende Einzelposten werden nicht als null Kosten interpretiert.</p>
<% detached = Enum.filter(r.volumes, & &1.detached) %>
<%= if detached != [] do %><h3>Abgehängte Volumes</h3><p><%= length(detached) %> Volumes · <%= H.number(BunnyStats.Analysis.sum_present(Enum.map(detached, & &1.size)), 0) %> GB bereitgestellt</p><p class="note">Bei unveränderter Kapazität rund <%= H.money(BunnyStats.Analysis.sum_present(Enum.map(detached, & &1.run_rate))) %> je vollem Monat. <a href="#volumes">Volumes ansehen</a></p><% end %>
<details class="method"><summary>Welche Kosten sind je Tag verfügbar?</summary><p>Historische Tagesnutzung ist verfügbar. Abrechnungsgenaue Tageskosten und CPU-/RAM-/Egress-Kosten pro App liefert die verwendete API nicht. Wir rechnen uneindeutige Messwerte nicht in scheinbar genaue Dollarbeträge um.</p><p>Volume-Kosten werden separat aus Kapazität und Zeit geschätzt. Echte Monatskosten stehen bei jeder App und für jede Kostenart.</p></details>
</div></div>
<section id="apps"><h2>Apps & Tage</h2><p class="note">Gemessene Tageswerte. CPU ist der unveränderte API-Chartwert, keine CPU-Sekunden. RAM und Volume-Werte sind aggregierte Messwerte. Traffic ist nicht gleich abgerechneter Egress. Heute ist unvollständig.</p>
<div class="toolbar" hidden id="tools"><label>App <input type="search" id="search" placeholder="Name filtern" aria-label="Apps nach Namen filtern"></label><button type="button" id="expand">Alle aufklappen</button><button type="button" id="collapse">Alle zuklappen</button></div>
<%= for app <- r.apps do %>
<details class="app" id="app-<%= H.escape(app["id"]) %>" data-name="<%= H.escape(String.downcase(app["name"])) %>">
<summary><span class="app-cost"><%= H.money(app["monthlyCost"], 4) %></span><%= H.escape(app["name"]) %><span class="state"><%= H.app_status(app["status"]) %></span></summary>
<div class="app-content"><div class="app-layout"><div><div class="summary"><div><span>Monatskosten laut API</span><strong><%= H.money(app["monthlyCost"], 4) %></strong></div><div><span>Traffic laut Statistik</span><strong><%= H.number(app["trafficGb"], 3) %> GB</strong></div></div><p class="note">App-ID: <code><%= H.escape(app["id"]) %></code></p><p class="note">CPU-, Memory- und Egress-Kosten pro App: nicht separat von der API ausgewiesen.</p></div><div class="chart"><h3>Traffic pro Tag</h3><%= H.traffic_chart(app["days"]) %><div class="chart-axis"><span><%= H.escape(r.month) %>-01</span><span><%= H.escape(String.slice(r.through, 0, 10)) %> · laufender Tag</span></div></div></div>
<div class="scroll"><table><thead><tr><th>Tag (UTC)</th><th>CPU-Chartwert</th><th>RAM GB</th><th>Traffic GB</th><th>Volume GB bereit</th><th>Volume GB belegt</th></tr></thead><tbody>
<%= for d <- Enum.reverse(app["days"]) do %><tr><td><%= H.escape(d.date) %><%= if d.partial, do: " *", else: "" %></td><td><%= H.number(d.cpu, 5) %></td><td><%= H.gb(d.ram) %></td><td><%= H.gb(d.traffic) %></td><td><%= H.gb(d.capacity) %></td><td><%= H.gb(d.used) %></td></tr><% end %>
</tbody></table></div><p class="note">* Laufender UTC-Tag. k. A. bedeutet fehlender Messwert, nicht null Nutzung. GB = 1.000.000.000 Bytes.</p></div></details>
<% end %></section>
<section id="volumes"><h2>Einzelne Volumes</h2><p class="note">Kapazitäts-Schätzung: 0,10 $ pro bereitgestelltem GB und Monat. Historisch aus täglichen Kapazitätswerten, ohne Abrechnungsgarantie. Abgehängte Volumes werden weiterhin berücksichtigt.</p><div class="scroll"><table><thead><tr><th>App / Volume</th><th>Zustand</th><th>GB bereit</th><th>GB belegt</th><th>Bisher geschätzt</th><th>Voller Monat²</th></tr></thead><tbody>
<%= for v <- r.volumes do %><tr><td><%= H.escape(v.app) %><br><span class="muted"><%= H.escape(v.name) %> · <%= H.escape(v.regions) %></span><br><span class="mono muted"><%= H.escape(v.id) %></span></td><td class="<%= if v.detached, do: "mismatch", else: "" %>"><%= cond do v.historical -> "historisch"; v.detached -> "abgehängt"; true -> "vorhanden" end %></td><td><%= H.number(v.size, 2) %></td><td><%= H.number(v.used, 4) %></td><td><%= H.money(v.cost, 4) %></td><td><%= H.money(v.run_rate) %></td></tr><% end %>
</tbody></table></div><p class="note">² Hochrechnung bei unveränderter aktueller Kapazität, kein bereits abgerechneter Betrag. Historische Volumes haben keine aktuelle Hochrechnung. Fehlende Messwerte und Änderungen innerhalb eines Tages begrenzen die Schätzung.</p></section>
<section id="reconciliation"><h2>Abgleich mit der Abrechnung</h2><div class="scroll"><table class="check-table"><thead><tr><th>Prüfung</th><th>Summe</th><th>Referenz</th><th>Differenz</th><th>Ergebnis</th></tr></thead><tbody>
<%= for c <- r.checks do %><tr><td><%= H.escape(c.label) %></td><td><%= H.money(c.observed, 4) %></td><td><%= H.money(c.expected, 4) %></td><td><%= H.money(c.delta, 4) %></td><td class="<%= c.status %>"><%= H.status(c.status) %></td></tr><% end %>
</tbody></table></div><p class="note checks-note">Toleranz: 0,005 $. Kleine Werte erscheinen in der Übersicht gerundet. Eine Übereinstimmung der Produkte bestätigt nicht die MC-Einzelposten. Abrufe sind nicht atomar; gelöschte Ressourcen, unterschiedliche Aktualisierungsstände oder Zeiträume können Differenzen verursachen. Die Ursache ist damit nicht bewiesen.</p>
<%= if r.reference != [] do %><h3>Lokaler Screenshot-Vergleich</h3><p class="note">Historischer Vergleich, gerundet auf Cent. Seit dem Screenshot entstandene Nutzung kann Werte erhöhen.</p><div class="scroll"><table class="check-table"><thead><tr><th>Position</th><th>Aktuelle API</th><th>Screenshot</th><th>Änderung</th><th>Vergleich</th></tr></thead><tbody><%= for c <- r.reference do %><tr><td><%= H.escape(c.label) %></td><td><%= H.money(c.observed) %></td><td><%= H.money(c.expected) %></td><td><%= H.money(c.delta, 4) %></td><td class="<%= c.status %>"><%= if c.status == :ok, do: "Identisch gerundet", else: "Geändert" %></td></tr><% end %></tbody></table></div><% end %>
<details class="method"><summary>Quellen und Berechnung</summary><ul><li>Account und Kostenarten: <code>GET /billing</code>. Scripting-Unterposten werden nicht zusätzlich zum Scripting-Gesamtbetrag summiert.</li><li>App-Monatskosten: <code>GET /mc/apps/{id}/overview</code>, Feld <code>monthlyCost</code>. Nur vorhandene Apps, auch inaktive.</li><li>Tageswerte: <code>GET /mc/apps/{id}/statistics</code> mit <code>granularity=Daily</code>, ab Monatsanfang bis <%= H.escape(r.through) %>. UTC-Tage entsprechen nicht exakt Berliner Kalendertagen.</li><li>Volumes: <code>GET /mc/apps/{id}/volumes</code> und <code>volumesSplitCapacityChart</code>. Kapazitätsbytes / 1e9 × erfasster Tagesanteil / Monatstage × 0,10 $. Kein künstlicher Ausgleich zur Rechnung.</li><li>CDN pro Pull Zone: <code>GET /billing/summary</code>. Separate Gegenprüfung, nicht zusätzlich zur CDN-Rechnung addiert.</li><li>CPU-Chartwerte haben keine ausreichend dokumentierte Abrechnungseinheit. RAM-Messwerte enthalten nicht zwingend alle Abrechnungsregeln. Statistik-Traffic kann andere Daten umfassen als berechneter Egress. Deshalb keine erfundenen Tageskosten.</li></ul></details>
</section>
<footer><p>Lokaler Bericht. Keine externen Ressourcen, keine API-Schlüssel, keine Änderungen am Bunny-Account.</p><div class="source-links"><a href="https://bunny.net/docs/api-reference/core/billing/get-billing-details">Billing API</a><a href="https://bunny.net/docs/api-reference/magic-containers/applications/get-application-statistics">Statistik-API</a><a href="https://bunny.net/docs/magic-containers/pricing">Preise und Abrechnungsregeln</a></div></footer>
</main><script>
document.getElementById('tools').hidden=false;
const apps=[...document.querySelectorAll('details.app')];
document.getElementById('search').addEventListener('input',event=>{const q=event.target.value.toLocaleLowerCase();apps.forEach(app=>app.hidden=!app.dataset.name.includes(q));});
document.getElementById('expand').addEventListener('click',()=>apps.filter(app=>!app.hidden).forEach(app=>app.open=true));
document.getElementById('collapse').addEventListener('click',()=>apps.forEach(app=>app.open=false));
function reveal(){const app=document.getElementById(location.hash.slice(1));if(app&&app.matches('details.app')){app.hidden=false;app.open=true;}}
document.querySelectorAll('[data-app-link]').forEach(link=>link.addEventListener('click',()=>{const app=document.getElementById(link.hash.slice(1));if(app){app.hidden=false;app.open=true;}}));
window.addEventListener('hashchange',reveal);reveal();
</script></body></html>
